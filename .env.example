# Database
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Tradier API
TRADIER_API_KEY=your_tradier_api_key
TRADIER_API_URL=https://api.tradier.com/v1

# Optional
NODE_ENV=development

# Transactional email (lib/email.ts, Resend HTTP API). The sender domain must be verified in Resend.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_xxxxxxxx
EMAIL_FROM="Stocks Trendz <support@yourdomain.com>"
EMAIL_REPLY_TO=support@yourdomain.com
# Trade Ideas alerts use only the address part of EMAIL_FROM, sent as "StocksTrendz Trade Ideas <address>".
# Trade Ideas email unsubscribe links (HMAC key, at least 32 chars). Without it emails carry no unsubscribe link/headers.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
IDEA_UNSUB_SECRET=
APP_BASE_URL=https://yourdomain.com

# Trade Ideas browser push (lib/ideaChannels.ts). Generate once with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a mailto: or https: contact the push services can reach. Telegram alerts reuse TELEGRAM_BOT_TOKEN.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# Database
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Tradier API
TRADIER_API_KEY=your_tradier_api_key
TRADIER_API_URL=https://api.tradier.com/v1

# Optional
NODE_ENV=development

# Transactional email (lib/email.ts, Resend HTTP API). The sender domain must be verified in Resend.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_xxxxxxxx
EMAIL_FROM="Stocks Trendz <support@yourdomain.com>"
EMAIL_REPLY_TO=support@yourdomain.com
APP_BASE_URL=https://yourdomain.com
